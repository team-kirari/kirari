{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kirari-photo-upload",
  "main": "index.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "ratelimits": [{
    "name": "UPLOAD_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }]
}
