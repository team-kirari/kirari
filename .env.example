# Public Firebase WEB app config, included in the client build.
# Fake placeholders only. Never put OAuth secrets or service account keys here.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
# Public upload API URL only. Never put the master key or GitHub token here.
VITE_PHOTO_UPLOAD_URL=https://kirari-photo-upload.your-subdomain.workers.dev
# Public story Worker URL. GitHub credentials belong only in Worker Secrets.
VITE_STORY_API_URL=https://kirari-stories.your-subdomain.workers.dev/stories
# Server-only local checkout path. Optional: defaults to ../kirari-private,
# then .local/kirari-private; CI always uses .local/kirari-private.
# KIRARI_PRIVATE_REPO_DIR=D:/path/to/kirari-private
