# Public Firebase WEB app config, included in the client build.
# Fake placeholders only. Never put OAuth secrets or service account keys here.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
